APP_NAME="Me, Myself and AI"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8092
APP_TIMEZONE=Europe/Rome
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

DB_CONNECTION=sqlite
SESSION_DRIVER=file
SESSION_COOKIE=sh_memyselfai_session
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false
CACHE_STORE=file
QUEUE_CONNECTION=sync
LOG_CHANNEL=stderr
LOG_LEVEL=warning
BCRYPT_ROUNDS=12

# One personal login. Generate the bcrypt hash with artisan memyselfai:password.
MEMYSELFAI_USERNAME=replace-with-your-username
MEMYSELFAI_PASSWORD_HASH='replace-with-bcrypt-hash'
MEMYSELFAI_CALENDAR_INCLUDE_DONE=false

# Optional MCP access. Generate a token with artisan memyselfai:mcp-token.
MEMYSELFAI_MCP_TOKEN=

# Docker Compose: bind to localhost by default.
MEMYSELFAI_BIND_IP=127.0.0.1
MEMYSELFAI_PORT=8092
MEMYSELFAI_URL=http://localhost:8092

# Use latest from main, or pin sha-<full commit> for controlled updates.
MEMYSELFAI_IMAGE=ghcr.io/metalogico/memyselfai:latest

# Optional overrides for running a separate instance from this checkout.
# MEMYSELFAI_ENV_FILE=.env
